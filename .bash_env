# ~/.bash_env: sourced once by login and interactive shell startup files
# Keep this file portable, fast, and limited to exported environment state

if [ "${BASH_ENV_LOADED:-}" = 1 ]; then
  return 0 2>/dev/null || exit 0
fi

# Configure Homebrew paths for macOS and Linuxbrew
if [ -z "${HOMEBREW_PREFIX:-}" ]; then
  for _bash_env_brew_prefix in /opt/homebrew /home/linuxbrew/.linuxbrew; do
    if [ -x "$_bash_env_brew_prefix/bin/brew" ]; then
      HOMEBREW_PREFIX=$_bash_env_brew_prefix
      HOMEBREW_CELLAR="$HOMEBREW_PREFIX/Cellar"
      break
    fi
  done
  unset _bash_env_brew_prefix
fi

if [ -n "${HOMEBREW_PREFIX:-}" ]; then
  : "${HOMEBREW_CELLAR:=$HOMEBREW_PREFIX/Cellar}"
  case ":$PATH:" in
    *":$HOMEBREW_PREFIX/sbin:"*) ;;
    *) PATH="$HOMEBREW_PREFIX/sbin:$PATH" ;;
  esac
  case ":$PATH:" in
    *":$HOMEBREW_PREFIX/bin:"*) ;;
    *) PATH="$HOMEBREW_PREFIX/bin:$PATH" ;;
  esac
  case ":${INFOPATH:-}:" in
    *":$HOMEBREW_PREFIX/share/info:"*) ;;
    *) INFOPATH="$HOMEBREW_PREFIX/share/info:${INFOPATH:-}" ;;
  esac
  export HOMEBREW_PREFIX HOMEBREW_CELLAR
fi

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":${MANPATH:-}:" in
  *":$HOME/.local/share/man:"*) ;;
  *) MANPATH="$HOME/.local/share/man:${MANPATH:-}" ;;
esac
case ":$PATH:" in
  *":$HOME/.cargo/bin:"*) ;;
  *) PATH="$HOME/.cargo/bin:$PATH" ;;
esac

# Use the XDG config location consistently on macOS
if [ "$(uname -s)" = Darwin ]; then
  : "${XDG_CONFIG_HOME:=$HOME/.config}"
  export XDG_CONFIG_HOME
fi

if command -v nvim >/dev/null 2>&1; then
  EDITOR=nvim
  export EDITOR
fi

BASH_ENV_LOADED=1
export BASH_ENV_LOADED PATH MANPATH INFOPATH
